<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signal Lights"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking permissions..."
            android:textSize="14sp"
            android:textColor="#b0bec5"
            android:layout_marginBottom="30dp"
            android:gravity="center" />

        <Button
            android:id="@+id/checkPermButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Grant Overlay Permission"
            android:textSize="14sp"
            android:background="@drawable/button_permission"
            android:textColor="#ffffff"
            android:layout_marginBottom="30dp"
            android:stateListAnimator="@null" />

        <EditText
            android:id="@+id/sessionNameInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Session name"
            android:textColorHint="#888888"
            android:textColor="#ffffff"
            android:background="@drawable/button_secondary"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/createBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Create Session"
            android:textSize="14sp"
            android:background="@drawable/button_primary"
            android:textColor="#ffffff"
            android:layout_marginBottom="30dp"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Active Sessions"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_marginBottom="15dp" />

        <LinearLayout
            android:id="@+id/sessionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
