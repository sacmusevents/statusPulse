<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/overlay_elegant_bg"
    android:baselineAligned="false">

    <!-- Close button -->
    <Button
        android:id="@+id/close_button"
        android:layout_width="40dp"
        android:layout_height="100dp"
        android:text="ˣ"
        android:textSize="16sp"
        android:textColor="#ff0000"
        android:background="@null"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:layout_margin="2dp"
        android:stateListAnimator="@null" />

    <!-- Drag button -->
    <Button
        android:id="@+id/drag_button"
        android:layout_width="40dp"
        android:layout_height="100dp"
        android:text="↕"
        android:textSize="18sp"
        android:textColor="#ffff00"
        android:background="@null"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:layout_margin="2dp"
        android:stateListAnimator="@null" />

    <!-- Red button -->
    <Button
        android:id="@+id/red_button"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_weight="3"
        android:background="@drawable/overlay_button_red"
        android:foreground="?attr/selectableItemBackground"
        android:layout_margin="4dp"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:stateListAnimator="@null" />

    <!-- Yellow button -->
    <Button
        android:id="@+id/yellow_button"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_weight="3"
        android:background="@drawable/overlay_button_yellow"
        android:foreground="?attr/selectableItemBackground"
        android:layout_margin="4dp"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:stateListAnimator="@null" />

    <!-- Green button -->
    <Button
        android:id="@+id/green_button"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_weight="3"
        android:background="@drawable/overlay_button_green"
        android:foreground="?attr/selectableItemBackground"
        android:layout_margin="4dp"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:stateListAnimator="@null" />

</LinearLayout>
